    {"id":"a1-4","titel":"Was ist das?","art":"saetze","station":"مَا","woerter":["ma-was"],"saetze":["a1s8","a1s9","a1s10","a1s11","a1s12","a1s13","a1s14","a1s15"],"uebungen":["diktat"],"tipp":{"titel":"Was ist das?","zeichen":"مَا هَذَا","text":"مَا fragt nach Dingen: مَا هَذَا؟ heißt „Was ist das?“. Die Antwort ist wieder ein Satz mit هَذَا."}},
